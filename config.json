{
  "spot_base": "https://data-api.binance.vision",
  "futures_base": "https://fapi.binance.com",
  "top_n": 150,
  "min_volume_usdt": 5000000,
  "min_history_hours": 720,
  "kline_pages": 3,
  "horizon_hours": 24,
  "threshold": 0.1,
  "atr_target_enabled": false,
  "atr_multiplier": 3.0,
  "atr_min_threshold": 0.02,
  "atr_max_threshold": 0.3,
  "max_spread_pct": 0.005,
  "min_depth_usdt_per_side": 50000,
  "order_book_limit": 500,
  "depth_band_pct": 0.01,
  "correlation_threshold": 0.9,
  "min_importance_pct": 0.1,
  "min_features": 5,
  "walk_forward_folds": 3,
  "test_fraction": 0.1,
  "calibration_fraction": 0.1,
  "sample_stride_hours": 24,
  "min_class_samples": 10,
  "calibration_bins": 10,
  "top_k": 10,
  "funding_interval_hours": 8,
  "request_timeout_seconds": 20,
  "request_retries": 3,
  "request_delay_seconds": 0.05,
  "output": "docs/data.json",
  "report_output": "docs/report.json",
  "skip_assets": [
    "USDC",
    "FDUSD",
    "TUSD",
    "USDP",
    "DAI",
    "EUR",
    "TRY",
    "USD1",
    "XUSD",
    "AEUR",
    "PAXG",
    "WBTC",
    "WBETH",
    "BUSD",
    "USDE",
    "USDS",
    "USDD",
    "PYUSD",
    "RLUSD",
    "EURC",
    "GBP",
    "BRL",
    "AUD",
    "BIDR",
    "RUB",
    "UAH",
    "WETH",
    "WBNB",
    "WSTETH",
    "BTCB"
  ],
  "model_params": {
    "n_estimators": 300,
    "learning_rate": 0.03,
    "num_leaves": 15,
    "min_child_samples": 100,
    "subsample": 0.8,
    "subsample_freq": 1,
    "colsample_bytree": 0.8,
    "reg_lambda": 5,
    "verbose": -1,
    "n_jobs": 2,
    "random_state": 42
  },
  "confidence_max_missing_low": 0.3,
  "confidence_max_missing_medium": 0.1,
  "confidence_min_events_low": 30,
  "confidence_min_events_medium": 100
}
